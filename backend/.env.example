# =============================================================================
# AI Panel Studio · 后端环境变量示例
# 复制为 .env 后按需填写；LLM_API_KEY 留空时自动进入离线演示（Mock Stream）模式
# =============================================================================

# DeepSeek 凭证（留空或仍为占位符时自动启用内置 Mock 流式演示）
# 填写真实 Key 后重启后端，即全量调用真实大模型：动态生成阵容、流式交锋与实时共识提炼
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容服务地址（DeepSeek 官方端点）
LLM_BASE_URL=https://api.deepseek.com

# 使用的模型名称
LLM_MODEL=deepseek-chat

# 单场讨论专家发言总条数上限（达到后主持人总结）
DISCUSSION_MAX_SPEECHES=8

# 每隔多少条发言刷新一次共识/分歧看板
INSIGHT_INTERVAL=3

# Mock 模式下每个 token 之间的间隔（秒）
MOCK_TOKEN_DELAY=0.025

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
