# =============================================================================
# AI Panel Studio · 后端环境变量示例
# 复制为 .env 后按需填写；LLM_API_KEY 留空时自动进入离线演示（Mock Stream）模式
# =============================================================================

# 大模型服务凭证（留空则启用内置 Mock 流式演示）
LLM_API_KEY=

# OpenAI 兼容服务地址（可指向任意兼容 Chat Completions 的网关）
LLM_BASE_URL=https://api.openai.com/v1

# 使用的模型名称
LLM_MODEL=gpt-4o-mini

# 单场讨论专家发言总条数上限（达到后主持人总结）
DISCUSSION_MAX_SPEECHES=8

# 每隔多少条发言刷新一次共识/分歧看板
INSIGHT_INTERVAL=3

# Mock 模式下每个 token 之间的间隔（秒）
MOCK_TOKEN_DELAY=0.025

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
