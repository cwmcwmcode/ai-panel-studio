# 虚拟环境与依赖
venv/
backend/venv/
node_modules/
frontend/node_modules/

# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 前端构建产物
dist/
frontend/dist/

# 环境变量敏感配置
.env
backend/.env

# 运行时临时数据库（注意：seed 初始化脚本保留，动态运行生成的 db 忽略）
*.db-journal
backend/data/*.db
!backend/data/seed_sample.db

# IDE 临时配置
.idea/
.vscode/
*.swp
